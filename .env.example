# --- Required (Phase 1 backend) ---

# PostgreSQL connection string. Local dev: see docs/BACKEND.md for setup.
# Production: use a managed Postgres (Neon recommended) with ?sslmode=require.
DATABASE_URL=postgresql://mentora:mentora_dev@localhost:5432/mentora

# Session-signing secret for Auth.js. Generate with: openssl rand -base64 32
# Use a DIFFERENT value per environment; never commit the real one.
AUTH_SECRET=replace-me

# --- Optional ---

# Test database used by `npm test` (defaults to <db>_test on localhost).
# TEST_DATABASE_URL=postgresql://mentora:mentora_dev@localhost:5432/mentora_test

# AI mentor. Set AI_PROVIDER=openai with a key to use a real LLM; otherwise
# the adaptive engine answers. The key must live behind the server route
# only — never expose it to the client bundle.
AI_PROVIDER=mock
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini                 # chat model (default shown)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # RAG retrieval model (default shown)

NEXT_PUBLIC_APP_URL=http://localhost:3000
